{
  "name": "@local/conv-3d-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D lab for convolutional feature maps: watch a kernel scan the input and build the next layer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
